{
  "name": "jaci-birthday",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A private, cinematic birthday surprise experience for Jacinta.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "start": "tsx server/serve.ts",
    "preview": "vite preview",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:db:create": "wrangler d1 create jaci-birthday",
    "cf:db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "framer-motion": "^11.11.7",
    "hono": "^4.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wrangler": "^4.124.0"
  }
}
