# ─────────────────────────────────────────────────────────────
# Jaci Birthday — environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git.
# ─────────────────────────────────────────────────────────────

# Admin password used to sign in to the private admin dashboard.
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie. Use a long random string.
AUTH_SECRET=generate-a-long-random-secret-here

# Where the draft/published configuration is stored (local file store).
STORAGE_PATH=data/config.json

# (Optional) Port for `npm start` (the production Node server).
PORT=8787

# ─── Cloudinary (optional but recommended) ───────────────────
# Get these from: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base folder where uploads are organised inside Cloudinary.
CLOUDINARY_FOLDER=jacinta-birthday
